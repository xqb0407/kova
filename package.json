{
  "name": "pi-kova",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/sidecar/*",
    "packages/*",
    "plugins/*"
  ],
  "overrides": {
    "unified": "^11.0.5",
    "@codemirror/view": "^6.43.12",
    "ai": "^7.0.105",
    "@assistant-ui/store": "^0.3.16",
    "@assistant-ui/core": "^0.3.22",
    "@assistant-ui/tap": "^0.9.20"
  },
  "scripts": {
    "build": "bun run --filter desktop build",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:sidecar": "bun run build:plugins && bun run --filter pi-agent-sidecar build",
    "dev": "bun run --filter desktop dev",
    "dev:mobile": "bun run --filter mobile start",
    "build:mobile:web": "bun run --filter mobile export:web",
    "typecheck:mobile": "bun run --filter mobile typecheck",
    "test:mobile": "bun run --filter mobile test",
    "release": "node scripts/release.mjs",
    "tauri:build": "bun run --filter desktop tauri:build",
    "tauri:dev": "bun run --filter desktop tauri:dev",
    "test": "bun run --filter pi-agent-sidecar test",
    "test:isolated": "bun run --filter pi-agent-sidecar test:isolated"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "playwright-core": "1.56.1"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.99.2": "patches/@earendil-works%2Fpi-ai@0.99.2.patch",
    "@earendil-works/pi-agent-core@0.99.2": "patches/@earendil-works%2Fpi-agent-core@0.99.2.patch",
    "@assistant-ui/core@0.3.22": "patches/@assistant-ui%2Fcore@0.3.22.patch"
  },
  "dependencies": {
    "@assistant-ui/react-o11y": "^0.0.45",
    "@assistant-ui/store": "^0.3.15"
  }
}
