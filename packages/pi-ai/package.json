{
	"name": "@earendil-works/pi-ai",
	"version": "1.5.2",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"sideEffects": [
		"./src/compat.ts",
		"./src/images.ts",
		"./src/providers/images/register-builtins.ts"
	],
	"exports": {
		".": "./src/index.ts",
		"./models": "./src/models.ts",
		"./session-resources": "./src/session-resources.ts",
		"./compat": "./src/compat.ts",
		"./providers/*": "./src/providers/*.ts",
		"./api/*": "./src/api/*.ts",
		"./utils/*": "./src/utils/*.ts",
		"./oauth": "./src/oauth.ts",
		"./bedrock-provider": "./src/bedrock-provider.ts",
		"./bun-oauth": "./src/bun-oauth.ts",
		"./lazy-oauth": "./src/lazy-oauth.ts",
		"./lazy-bedrock-provider": "./src/lazy-bedrock-provider.ts",
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.129.0",
		"@aws-sdk/client-bedrock-runtime": "3.1127.0",
		"@earendil-works/pi-schema": "1.5.2",
		"@earendil-works/pi-telemetry": "1.5.2",
		"@google/genai": "2.32.0",
		"@smithy/node-http-handler": "4.12.1",
		"http-proxy-agent": "9.1.0",
		"https-proxy-agent": "9.1.0",
		"openai": "7.19.0",
		"partial-json": "0.1.7"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
