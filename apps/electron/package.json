{
  "name": "kova-electron-main",
  "private": true,
  "version": "1.1.8-preview",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "node scripts/build.mjs && electron . --dev",
