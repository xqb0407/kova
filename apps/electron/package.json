{
  "name": "kova-electron-main",
  "private": true,
  "version": "1.2.4",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/ensure-electron.mjs && electron .",
    "dev": "node scripts/build.mjs && node scripts/ensure-electron.mjs && electron . --dev",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "e2e:inbox": "node scripts/e2e-inbox.mjs",
    "dist": "electron-builder",
    "dist:dev": "electron-builder --config electron-builder.dev.yml"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "automation-core": "workspace:*",
    "pi-protocol": "workspace:*",
    "pi-sandbox": "workspace:*",
    "pi-edit-match": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.5.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "@larksuiteoapi/node-sdk": "1.64.0",
    "dingtalk-stream": "2.1.5",
    "@wecom/aibot-node-sdk": "1.0.7"
  }
}
